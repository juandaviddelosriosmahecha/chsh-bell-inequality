# IBM Quantum credentials. Copy to `.env` and fill in. NEVER commit `.env`.
# Obtain a token at https://quantum.ibm.com/
IBM_QUANTUM_TOKEN=
# Optional: CRN/instance string for the Qiskit Runtime service.
IBM_QUANTUM_INSTANCE=
# Optional: default backend name (e.g. ibm_torino). Leave blank to use least_busy.
IBM_QUANTUM_BACKEND=
